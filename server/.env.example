# Local dev: single-node replica set started with `npm run db` (transactions need a replica set)
MONGODB_URI=mongodb://127.0.0.1:27018/decants?replicaSet=rs0
# Any long random string; `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
# 5000 is taken by macOS AirPlay Receiver
PORT=5050
# Origin allowed to call the API with cookies (the Vite dev server locally)
CLIENT_ORIGIN=http://localhost:5173

# Photos: set on Vercel (Storage → Blob). Leave empty locally to store uploads in ./.uploads
BLOB_READ_WRITE_TOKEN=
